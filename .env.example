# Copy this file to ".env" and fill in your real values.
# The app reads these automatically on startup. Never commit .env to git.

# Random string that signs login sessions (make one with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-string

# Free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Persistent Postgres connection string (free at https://neon.tech)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Leave DATABASE_URL empty to use the local SQLite file (universe.db)
